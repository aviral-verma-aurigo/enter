# enter-bot environment — copy to `.env` and fill in. Never commit `.env`.
# Full reference: packages/docs/src/content/docs/config/env.md

# ─── Required: model provider ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Required: Bot Framework (Azure Bot resource) ───────────────────────────
# From the Azure Bot resource: App ID + a generated client secret.
MicrosoftAppId=
MicrosoftAppPassword=
# Single-tenant bots only; leave blank for multi-tenant.
MicrosoftAppTenantId=

# ─── Required for PRs: GitHub App ───────────────────────────────────────────
# See packages/docs/src/content/docs/deploy/github-app.md
GITHUB_APP_ID=
# Either a path to the .pem ...
GITHUB_APP_PRIVATE_KEY_PATH=/etc/secrets/enter-bot.pem
# ... or inline PEM contents (escape newlines as \n). Use one, not both.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# Optional — auto-discovered per repo if omitted.
# GITHUB_APP_INSTALLATION_ID=

# ─── Operational ────────────────────────────────────────────────────────────
PORT=3978
# Writable dirs. In containers, mount a persistent volume for the audit DB
# (losing it loses per-channel token-budget bookkeeping).
ENTER_BOT_WORKTREES=/var/lib/enter-bot/worktrees
ENTER_BOT_AUDIT_DB=/var/lib/enter-bot/audit.db
# Lock the bot to specific channels / repos in production.
# ENTER_BOT_CHANNEL_ALLOWLIST=19:abc...@thread.tacv2,19:def...@thread.tacv2
# ENTER_BOT_ALLOWED_REPOS=your-org/repo-a,your-org/repo-b
ENTER_BOT_MONTHLY_TOKEN_BUDGET=1000000
# DEV ONLY — disables the public-only constraint for the Bot Framework Emulator.
# Never set in a deployed environment.
# ENTER_BOT_ALLOW_DM=1

# ─── Optional integrations (omit a block to disable its tools) ──────────────
# Azure DevOps work items (service principal recommended for the bot):
# ADO_ORG_URL=https://dev.azure.com/your-org
# ADO_TENANT_ID=
# ADO_CLIENT_ID=
# ADO_CLIENT_SECRET=

# Confluence Cloud:
# CONFLUENCE_BASE_URL=https://your.atlassian.net/wiki
# CONFLUENCE_USER=bot-account@your-org.com
# CONFLUENCE_API_TOKEN=

# Aha!:
# AHA_BASE_URL=https://your.aha.io
# AHA_API_KEY=
